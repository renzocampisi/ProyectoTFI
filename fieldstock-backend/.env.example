PORT=3000
SUPABASE_URL=https://elxmkqascjsyoakedlqf.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui

# M1 Panel IA — Google Gemini API.
# Sacar en https://aistudio.google.com/app/apikey (gratis, sin tarjeta).
# Si falta, el endpoint /api/panel/chat devuelve 503 con mensaje claro.
GEMINI_API_KEY=tu-gemini-api-key-aqui

# Suscripciones — Mercado Pago (Preapproval).
# MP_ACCESS_TOKEN: credencial privada de tu app en https://www.mercadopago.com.ar/developers/panel/app
#   (usar el access token de TEST mientras se prueba, nunca el de producción en dev).
# MP_WEBHOOK_SECRET: "Clave secreta" de la sección Webhooks de esa misma app —
#   se usa para validar la firma (x-signature) de cada notificación.
# FRONTEND_URL: URL pública del frontend — se usa para armar el back_url al
#   que Mercado Pago redirige al DUEÑO después de autorizar el pago.
MP_ACCESS_TOKEN=tu-mp-access-token-de-test-aqui
MP_WEBHOOK_SECRET=tu-mp-webhook-secret-aqui
FRONTEND_URL=http://localhost:5173
